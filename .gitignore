# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files — never commit real credentials. `.env.*` also catches
# backups like `.env.bak` / `.env.2026-01-01` that hold the same secrets.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Uploads — user files (HR documents, receipts, branding) live on the server
# only. The API creates these directories at boot (bootstrapStorage in
# server/src/app.ts), so nothing here needs to be tracked.
uploads/
**/uploads/
server/uploads/

# Database Backups (pre-migration SQL dumps written by server/scripts/backup.cjs)
backups/
**/backups/
server/backups/
*.sql.gz

# Next.js landing page build output
landing-page/.next/
landing-page/out/

# Claude local settings
.claude/


