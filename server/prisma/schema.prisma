generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  role          UserRole       @default(CLIENT)
  name          String
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  client        Client?
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(512)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Client {
  id            String         @id @default(uuid())
  userId        String?        @unique @map("user_id")
  name          String
  email         String
  phone         String?
  company       String
  website       String?
  address       String?
  city          String?
  country       String?
  industry      String?
  notes         String?        @db.Text
  status        ClientStatus   @default(ACTIVE)
  initials      String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  user          User?          @relation(fields: [userId], references: [id])
  invoices      Invoice[]
  proformas     Proforma[]
  projects      Project[]
  subscriptions Subscription[]

  @@index([email])
  @@index([company])
  @@map("clients")
}

model Project {
  id          String              @id @default(uuid())
  name        String
  clientId    String              @map("client_id")
  description String?             @db.Text
  status      ProjectStatus       @default(IN_PROGRESS)
  priority    Priority            @default(MEDIUM)
  progress    Int                 @default(0)
  budget      Int?
  startDate   DateTime?           @map("start_date")
  dueDate     DateTime?           @map("due_date")
  tags        String?             @db.Text
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  teamMembers ProjectTeamMember[]
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("projects")
}

model ProjectTeamMember {
  id         String     @id @default(uuid())
  projectId  String     @map("project_id")
  memberId   String     @map("member_id")
  teamMember TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@index([memberId], map: "project_team_members_member_id_fkey")
  @@map("project_team_members")
}

model TeamMember {
  id         String              @id @default(uuid())
  name       String
  email      String              @unique
  phone      String?
  role       String
  department String?
  status     MemberStatus        @default(ACTIVE)
  avatar     String?
  hourlyRate Int?                @map("hourly_rate")
  startDate  DateTime?           @map("start_date")
  bio        String?             @db.Text
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")
  projects   ProjectTeamMember[]

  @@map("team_members")
}

model Invoice {
  id                 String              @id @default(uuid())
  invoiceNumber      String              @unique @map("invoice_number")
  clientId           String              @map("client_id")
  amount             Int
  status             InvoiceStatus       @default(PENDING)
  date               DateTime
  dueDate            DateTime            @map("due_date")
  notes              String?             @db.Text
  taxRate            Float?              @map("tax_rate")
  discount           Float?
  discountType       DiscountType?       @map("discount_type")
  deposit            Int?
  paymentMethod      String?             @map("payment_method")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  items              InvoiceItem[]
  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  verificationTokens VerificationToken[]

  @@index([clientId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Int
  unitPrice   Int     @map("unit_price")
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Proforma {
  id                 String              @id @default(uuid())
  proformaNumber     String              @unique @map("proforma_number")
  clientId           String              @map("client_id")
  amount             Int
  status             ProformaStatus      @default(DRAFT)
  date               DateTime
  dueDate            DateTime            @map("due_date")
  notes              String?             @db.Text
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  items              ProformaItem[]
  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  verificationTokens VerificationToken[]

  @@index([clientId])
  @@map("proformas")
}

model ProformaItem {
  id          String   @id @default(uuid())
  proformaId  String   @map("proforma_id")
  description String
  quantity    Int
  unitPrice   Int      @map("unit_price")
  proforma    Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)

  @@index([proformaId])
  @@map("proforma_items")
}

model Subscription {
  id           String             @id @default(uuid())
  clientId     String             @map("client_id")
  packageId    String?            @map("package_id")
  plan         String
  amount       Int
  billingCycle BillingCycle       @default(MONTHLY) @map("billing_cycle")
  started      DateTime
  renewal      DateTime?
  status       SubscriptionStatus @default(ACTIVE)
  features     String?            @db.Text
  notes        String?            @db.Text
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  package      Package?           @relation(fields: [packageId], references: [id])

  @@index([clientId])
  @@index([packageId])
  @@map("subscriptions")
}

model Package {
  id              String           @id @default(uuid())
  name            String
  description     String           @db.Text
  price           Int
  features        String?          @db.Text
  type            PackageType      @default(SUBSCRIPTION)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  packageServices PackageService[]
  subscriptions   Subscription[]

  @@map("packages")
}

model Service {
  id              String           @id @default(uuid())
  name            String
  category        String
  basePrice       Int              @map("base_price")
  description     String           @db.Text
  status          ServiceStatus    @default(AVAILABLE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  packageServices PackageService[]

  @@map("services")
}

model PackageService {
  id        String  @id @default(uuid())
  packageId String  @map("package_id")
  serviceId String  @map("service_id")
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceId])
  @@index([serviceId], map: "package_services_service_id_fkey")
  @@map("package_services")
}

model VerificationToken {
  id           String    @id @default(uuid())
  token        String    @unique @db.VarChar(128)
  documentType String    @map("document_type")
  invoiceId    String?   @map("invoice_id")
  proformaId   String?   @map("proforma_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  invoice      Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  proforma     Proforma? @relation(fields: [proformaId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([proformaId])
  @@map("verification_tokens")
}

model AgencySettings {
  id                  String   @id @default(uuid())
  agencyName          String   @map("agency_name")
  adminEmail          String   @map("admin_email")
  phone               String?
  website             String?
  address             String?  @db.LongText
  currency            String   @default("USD")
  timezone            String   @default("UTC")
  logo                String?  @db.LongText
  whiteLogo           String?  @map("white_logo") @db.LongText
  favicon             String?  @db.LongText
  primaryColor        String?  @map("primary_color")
  taxRate             Float    @default(0) @map("tax_rate")
  defaultInvoiceNotes String?  @map("default_invoice_notes") @db.LongText
  paymentMethods      String?  @map("payment_methods") @db.LongText
  socialLinks         String?  @map("social_links") @db.LongText
  notifications       String?  @db.LongText
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("agency_settings")
}

enum UserRole {
  ADMIN
  CLIENT
}

enum ClientStatus {
  ACTIVE
  PAUSED
  CHURNED
}

enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MemberStatus {
  ACTIVE
  OFFLINE
  AWAY
}

enum InvoiceStatus {
  PAID
  PENDING
  OVERDUE
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ProformaStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  TRIAL
}

enum PackageType {
  SERVICE
  SUBSCRIPTION
  ONE_TIME
}

enum ServiceStatus {
  AVAILABLE
  UNAVAILABLE
}
