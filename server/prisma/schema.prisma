  rating    Int      @default(5)
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("testimonials")
}

model LandingPageProject {
  id          String   @id @default(uuid())
  title       String
  category    String
  description String   @db.Text
  imageUrl    String   @map("image_url")
  imageUrl2   String?  @map("image_url_2")
  imageUrl3   String?  @map("image_url_3")
  imageUrl4   String?  @map("image_url_4")
  clientName  String?  @map("client_name")
  projectDate String?  @map("project_date")
  location    String?
  duration    String?
  sections    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("landing_page_projects")
}

enum NotificationCategory {
  ACTION_REQUIRED
  INFORMATION
  SUCCESS
  WARNING
}

model Notification {
  id         String               @id @default(uuid())
  userId     String?              @map("user_id")
  title      String
  message    String
  type       String // e.g. "INVOICE_PAID", "PROJECT_OVERDUE"
  category   NotificationCategory @default(INFORMATION)
  entityType String?              @map("entity_type") // "INVOICE" | "PROJECT" | "CLIENT" | "EMPLOYEE" | "SUBSCRIPTION"
  entityId   String?              @map("entity_id")
  actionUrl  String?              @map("action_url")
  read       Boolean              @default(false)
  createdAt  DateTime             @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model SocialAccount {
  id               String    @id @default(uuid())
  clientId         String    @map("client_id")
  platform         String // 'facebook'|'instagram'|'tiktok'|'linkedin'|'youtube'|'x'|'threads'|'pinterest'
  platformUserId   String    @map("platform_user_id")
  platformUsername String    @map("platform_username")
  displayName      String    @map("display_name")
  avatarUrl        String?   @map("avatar_url") @db.Text
  pageId           String?   @map("page_id")
  igAccountId      String?   @map("ig_account_id")
  accessTokenEnc   String    @map("access_token_enc") @db.Text
  refreshTokenEnc  String?   @map("refresh_token_enc") @db.Text
  tokenExpiresAt   DateTime? @map("token_expires_at")
  healthStatus     String    @default("healthy") @map("health_status")
  healthMessage    String?   @map("health_message") @db.Text
  rateLimitedUntil DateTime? @map("rate_limited_until")
  groupName        String?   @map("group_name")
  groupColor       String?   @map("group_color")
  isActive         Boolean   @default(true) @map("is_active")
  // Last time an analytics export (e.g. TikTok Studio XLSX) was imported for
  // this account — powers the "Imported · updated {date}" provenance chip.
  lastImportedAt   DateTime? @map("last_imported_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  client        Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  destinations  SocialPostDestination[]
  insightsDaily AccountInsightDaily[]
  demographics  AccountDemographic[]
  activity      AccountActivity[]
  importedPosts ImportedPost[]

  @@unique([clientId, platform, platformUserId])
  @@index([clientId])
  @@map("social_accounts")
}

model SocialPost {
  id              String    @id @default(uuid())
  clientId        String    @map("client_id")
  caption         String    @db.Text
  platformContent Json?     @map("platform_content")
  mediaUrls       Json?     @map("media_urls")
  mediaType       String?   @map("media_type")
  status          String    @default("DRAFT")
  scheduledFor    DateTime? @map("scheduled_for")
  publishedAt     DateTime? @map("published_at")
  campaignId      String?   @map("campaign_id")
  errorMessage    String?   @map("error_message") @db.Text
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  client       Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  destinations SocialPostDestination[]
  insights     PostInsight[]

  @@index([clientId])
  @@index([status, scheduledFor])
  @@map("social_posts")
}

model SocialPostDestination {
  id              String    @id @default(uuid())
  postId          String    @map("post_id")
  socialAccountId String    @map("social_account_id")
  platform        String
  status          String    @default("QUEUED") // QUEUED|PUBLISHING|PUBLISHED|FAILED|DRAFT
  platformPostId  String?   @map("platform_post_id")
  // Canonical public URL of the published item (e.g. TikTok video link). For
  // TikTok this lets us store/resolve the real numeric video id used to match
  // TikTok Studio export rows back to the post we published.
  platformPostUrl String?   @map("platform_post_url") @db.Text
  publishedAt     DateTime? @map("published_at")
  lastError       String?   @map("last_error") @db.Text
  attempts        Int       @default(0)
  lastAttemptAt   DateTime? @map("last_attempt_at")
  lockedAt        DateTime? @map("locked_at")

  post          SocialPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([status, lockedAt])
  @@map("social_post_destinations")
}

model AccountInsightDaily {
  id                    String   @id @default(uuid())
  socialAccountId       String   @map("social_account_id")
  date                  DateTime @db.Date
  followers             Int?
  reach                 Int?
  impressions           Int?
  profileVisits         Int?     @map("profile_visits")
  // FIX: YouTube's reach/impressions are computed as a daily delta off the
  // channel's cumulative lifetime view count. That "previous lifetime views"
  // number was previously stashed in profileVisits — a field that means an
  // actual profile-visit count for every other platform — so any generic
  // dashboard reading profileVisits showed nonsense for YouTube rows. It now
  // has its own column.
  lifetimeViewsSnapshot Int?     @map("lifetime_views_snapshot")
  engagementRate        Decimal? @map("engagement_rate") @db.Decimal(5, 2)

  // Extra daily metrics populated by imported exports (e.g. TikTok Studio XLSX).
  // Nullable so live-API rows (which don't provide them) stay honestly empty.
  videoViews       Int?   @map("video_views")
  likes            Int?
  comments         Int?
  shares           Int?
  newViewers       Int?   @map("new_viewers")
  returningViewers Int?   @map("returning_viewers")
  // Provenance: 'api' = fetched live from the platform, 'import' = uploaded export.
  source           String @default("api")

  account SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, date])
  @@index([socialAccountId])
  @@map("account_insights_daily")
}

model PostInsight {
  id          String   @id @default(uuid())
  postId      String   @map("post_id")
  platform    String
  impressions Int?
  reach       Int?
  likes       Int?
  comments    Int?
  shares      Int?
  saved       Int?
  views       Int?
  fetchedAt   DateTime @default(now()) @map("fetched_at")

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  // FIX: without this, collectDailyInsights() had no way to upsert — it called
  // .create() every day for up to 7 days per post/platform, so analytics summed
  // multiple stale+current snapshots together instead of the one current value,
  // inflating likes/comments/shares/reach/impressions more each day a post aged.
  @@unique([postId, platform])
  @@index([postId])
  @@map("post_insights")
}

// Audience demographics for an account (gender / country / age splits). Populated
// from imported analytics exports (TikTok Studio) or, later, platform APIs. Each
// row is one slice: e.g. kind='gender' label='Male' fraction=0.62.
model AccountDemographic {
  id              String   @id @default(uuid())
  socialAccountId String   @map("social_account_id")
  kind            String // 'gender' | 'country' | 'age'
  label           String // 'Male' | 'US' | '18-24' | 'Others'
  fraction        Float // 0..1
  source          String   @default("import")
  updatedAt       DateTime @updatedAt @map("updated_at")

  account SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, kind, label])
  @@index([socialAccountId])
  @@map("account_demographics")
}

// Follower active-time heatmap: average active followers per weekday+hour.
// Aggregated at import time from TikTok Studio's FollowerActivity export.
model AccountActivity {
  id              String   @id @default(uuid())
  socialAccountId String   @map("social_account_id")
  weekday         Int // 0=Sun .. 6=Sat
  hour            Int // 0..23
  activeFollowers Int      @map("active_followers")
  source          String   @default("import")
  updatedAt       DateTime @updatedAt @map("updated_at")

  account SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, weekday, hour])
  @@index([socialAccountId])
  @@map("account_activity")
}

// Per-video/post metrics imported from an export (TikTok Studio "Content"), for
// content the account posted natively (not through our scheduler). Kept separate
// from social_posts so imported native content never pollutes the composer/queue.
// Keyed by the platform's own id (TikTok video id parsed from the video link).
model ImportedPost {
  id              String    @id @default(uuid())
  socialAccountId String    @map("social_account_id")
  platform        String
  externalId      String    @map("external_id")
  title           String?   @db.Text
  link            String?   @db.Text
  postedAt        DateTime? @map("posted_at")
  likes           Int?
  comments        Int?
  shares          Int?
  views           Int?
  source          String    @default("import")
  thumbnailUrl    String?   @map("thumbnail_url") @db.Text
  isVerified      Boolean   @default(false) @map("is_verified")
  verifiedAt      DateTime? @map("verified_at")
  verificationSource String? @map("verification_source")
  importedAt      DateTime  @default(now()) @map("imported_at")

  account SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, externalId])
  @@index([socialAccountId])
  @@map("imported_posts")
}

model SocialCampaign {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("social_campaigns")
}

// ─────────────────────────────────────────────────────────────
//  EMAIL CENTER
//  Resend is the transport layer only; this app is the mailbox.
// ─────────────────────────────────────────────────────────────

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum EmailStatus {
  DRAFT
  QUEUED
  SCHEDULED
  SENT
  DELIVERED
  DELIVERY_DELAYED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  FAILED
  CANCELED
  RECEIVED
}

enum EmailEventType {
  QUEUED
  SCHEDULED
  SENT
  DELIVERED
  DELIVERY_DELAYED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  FAILED
  CANCELED
  RECEIVED
  REPLIED
}

enum ConversationStatus {
  OPEN
  PENDING
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum MailboxAccessLevel {
  READ
  WRITE
  MANAGE
}

enum EmailPriority {
  LOW
  NORMAL
  HIGH
}

enum ParticipantRole {
  FROM
  TO
  CC
  BCC
}

enum TemplateCategory {
  SUPPORT
  SALES
  INVOICES
  MARKETING
  HR
  LEGAL
  SAVED_REPLY
}

model Mailbox {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String   @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  signature   String?  @db.Text
  department  String?
  replyTo     String?  @map("reply_to")
  color       String?
  isActive    Boolean  @default(true) @map("is_active")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions   MailboxPermission[]
  conversations Conversation[]
  emails        Email[]
  templates     EmailTemplate[]

  @@map("mailboxes")
}

model MailboxPermission {
  id          String             @id @default(uuid())
  mailboxId   String             @map("mailbox_id")
  userId      String             @map("user_id")
  accessLevel MailboxAccessLevel @default(WRITE) @map("access_level")
  createdAt   DateTime           @default(now()) @map("created_at")

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  user    User    @relation("UserMailboxPermissions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, userId])
  @@index([userId])
  @@map("mailbox_permissions")
}

model Conversation {
  id             String             @id @default(uuid())
  mailboxId      String             @map("mailbox_id")
  subject        String             @db.Text
  clientId       String?            @map("client_id")
  assigneeId     String?            @map("assignee_id")
  status         ConversationStatus @default(OPEN)
  threadKey      String?            @map("thread_key")
  snippet        String?            @db.Text
  messageCount   Int                @default(0) @map("message_count")
  unreadCount    Int                @default(0) @map("unread_count")
  hasAttachment  Boolean            @default(false) @map("has_attachment")
  isStarred      Boolean            @default(false) @map("is_starred")
  isImportant    Boolean            @default(false) @map("is_important")
  isFlagged      Boolean            @default(false) @map("is_flagged")
  isSpam         Boolean            @default(false) @map("is_spam")
  isArchived     Boolean            @default(false) @map("is_archived")
  lastMessageAt  DateTime?          @map("last_message_at")
  lastInboundAt  DateTime?          @map("last_inbound_at")
  lastOutboundAt DateTime?          @map("last_outbound_at")
  deletedAt      DateTime?          @map("deleted_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  mailbox      Mailbox                   @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  client       Client?                   @relation(fields: [clientId], references: [id])
  assignee     User?                     @relation("UserAssignedConversations", fields: [assigneeId], references: [id])
  emails       Email[]
  participants ConversationParticipant[]
  notes        ConversationNote[]
  labels       ConversationLabel[]

  @@index([mailboxId])
  @@index([clientId])
  @@index([assigneeId])
  @@index([threadKey])
  @@index([lastMessageAt])
  @@index([status])
  @@map("conversations")
}

model ConversationParticipant {
  id             String          @id @default(uuid())
  conversationId String          @map("conversation_id")
  email          String
  name           String?
  role           ParticipantRole @default(TO)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, email, role])
  @@index([conversationId])
  @@index([email])
  @@map("conversation_participants")
}

model Email {
  id             String         @id @default(uuid())
  conversationId String         @map("conversation_id")
  mailboxId      String         @map("mailbox_id")
  direction      EmailDirection
  status         EmailStatus    @default(QUEUED)
  priority       EmailPriority  @default(NORMAL)

  fromEmail String  @map("from_email")
  fromName  String? @map("from_name")
  toEmails  Json    @map("to_emails")
  ccEmails  Json?   @map("cc_emails")
  bccEmails Json?   @map("bcc_emails")

  subject String  @db.Text
  html    String? @db.LongText
  text    String? @db.LongText
  snippet String? @db.Text

  resendId   String? @map("resend_id")
  messageId  String? @map("message_id") @db.VarChar(512)
  inReplyTo  String? @map("in_reply_to") @db.VarChar(512)
  references String? @map("email_references") @db.Text
  headers    Json?

  sentById     String?   @map("sent_by_id")
  scheduledAt  DateTime? @map("scheduled_at")
  sentAt       DateTime? @map("sent_at")
  isRead       Boolean   @default(false) @map("is_read")
  errorMessage String?   @map("error_message") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mailbox      Mailbox      @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  sentBy       User?        @relation("UserSentEmails", fields: [sentById], references: [id])
  events       EmailEvent[]
  attachments  Attachment[]

  @@index([conversationId])
  @@index([mailboxId])
  @@index([resendId])
  @@index([messageId])
  @@index([status])
  @@index([direction])
  @@map("emails")
}

model EmailEvent {
  id         String         @id @default(uuid())
  emailId    String         @map("email_id")
  type       EmailEventType
  payload    Json?
  link       String?        @db.Text
  occurredAt DateTime       @default(now()) @map("occurred_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@index([type])
  @@map("email_events")
}

model Attachment {
  id             String   @id @default(uuid())
  emailId        String?  @map("email_id")
  draftId        String?  @map("draft_id")
  filename       String
  mimeType       String   @map("mime_type")
  size           Int
  storageKey     String   @map("storage_key")
  checksum       String?
  isInline       Boolean  @default(false) @map("is_inline")
  contentId      String?  @map("content_id")
  version        Int      @default(1)
  supersededById String?  @unique @map("superseded_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  email Email? @relation(fields: [emailId], references: [id], onDelete: Cascade)
  draft Draft? @relation(fields: [draftId], references: [id], onDelete: Cascade)

  // Version chain: this row was replaced by `supersededBy`; `previousVersion`
  // is the older row this one replaced.
  supersededBy    Attachment? @relation("AttachmentVersions", fields: [supersededById], references: [id])
  previousVersion Attachment? @relation("AttachmentVersions")

  @@index([emailId])
  @@index([draftId])
  @@map("email_attachments")
}

model EmailLabel {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("#6366f1")
  createdAt DateTime @default(now()) @map("created_at")

  conversations ConversationLabel[]

  @@map("email_labels")
}

model ConversationLabel {
  conversationId String @map("conversation_id")
  labelId        String @map("label_id")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label        EmailLabel   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([conversationId, labelId])
  @@index([labelId])
  @@map("conversation_labels")
}

model EmailTemplate {
  id          String           @id @default(uuid())
  name        String
  category    TemplateCategory @default(SUPPORT)
  subject     String           @db.Text
  body        String           @db.LongText
  variables   Json?
  mailboxId   String?          @map("mailbox_id")
  createdById String?          @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  mailbox Mailbox? @relation(fields: [mailboxId], references: [id], onDelete: SetNull)

  @@index([category])
  @@map("email_templates")
}

model Draft {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  mailboxId      String?       @map("mailbox_id")
  conversationId String?       @map("conversation_id")
  toEmails       Json?         @map("to_emails")
  ccEmails       Json?         @map("cc_emails")
  bccEmails      Json?         @map("bcc_emails")
  subject        String?       @db.Text
  html           String?       @db.LongText
  priority       EmailPriority @default(NORMAL)
  scheduledAt    DateTime?     @map("scheduled_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user        User         @relation("UserEmailDrafts", fields: [userId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([userId])
  @@map("email_drafts")
}

model ConversationNote {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  authorId       String   @map("author_id")
  body           String   @db.Text
  mentions       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User         @relation("UserConversationNotes", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("conversation_notes")
}

model WebhookLog {
  id         String   @id @default(uuid())
  source     String   @default("resend")
  eventType  String   @map("event_type")
  resendId   String?  @map("resend_id")
  payload    Json
  verified   Boolean  @default(false)
  processed  Boolean  @default(false)
  error      String?  @db.Text
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([eventType])
  @@index([resendId])
  @@map("email_webhook_logs")
}
