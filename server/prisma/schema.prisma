generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  username              String?                @unique
  passwordHash          String                 @map("password_hash")
  mustChangePassword    Boolean                @default(false) @map("must_change_password")
  passwordResetToken    String?                @unique @map("password_reset_token") @db.VarChar(512)
  passwordResetExpiry   DateTime?              @map("password_reset_expiry")
  role                  UserRole               @default(CLIENT)
  name                  String
  /// Per-module access overrides: { "clients": "WRITE", "invoices": "READ", ... }
  /// Levels: NONE | READ | WRITE | MANAGE. ADMIN always has full access.
  permissions           Json?
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  client                Client?
  teamMember            TeamMember?
  monthlyReports        MonthlyReport[]        @relation("MonthlyReportCreatedBy")
  monthlyReportVersions MonthlyReportVersion[] @relation("MonthlyReportVersionCreatedBy")
  refreshTokens         RefreshToken[]
  hrDocumentsGenerated  HrDocument[]           @relation("HrDocumentGeneratedBy")
  hrDocumentsApproved   HrDocument[]           @relation("HrDocumentApprovedBy")
  hrDocumentApprovals   HrDocumentApproval[]   @relation("HrDocumentApprovals")
  sharedFiles           SharedFile[]           @relation("SharedFileUploadedBy")
  notifications         Notification[]
  deviceTokens          DeviceToken[]

  // Email Center
  mailboxPermissions    MailboxPermission[] @relation("UserMailboxPermissions")
  assignedConversations Conversation[]      @relation("UserAssignedConversations")
  sentEmails            Email[]             @relation("UserSentEmails")
  emailDrafts           Draft[]             @relation("UserEmailDrafts")
  conversationNotes     ConversationNote[]  @relation("UserConversationNotes")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  // Stored as SHA-256 hex of the JWT refresh token (never store raw tokens)
  token     String   @unique @db.VarChar(512)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  token      String   @unique @db.VarChar(512)
  platform   String // ios | android | web
  deviceName String?  @map("device_name") @db.VarChar(255)
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model Client {
  id                   String                @id @default(uuid())
  userId               String?               @unique @map("user_id")
  name                 String
  email                String?
  phone                String?
  company              String
  type                 ClientType            @default(BUSINESS)
  website              String?
  address              String?
  city                 String?
  country              String?
  industry             String?
  notes                String?               @db.Text
  status               ClientStatus          @default(ACTIVE)
  initials             String?
  invoiceGenerationDay Int?                  @map("invoice_generation_day")
  paymentReminderDelay Int?                  @map("payment_reminder_delay")
  overdueNoticeDelay   Int?                  @map("overdue_notice_delay")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  user                 User?                 @relation(fields: [userId], references: [id])
  invoices             Invoice[]
  proformas            Proforma[]
  projects             Project[]
  subscriptions        Subscription[]
  socialProfiles       ClientSocialProfile[]
  documents            ClientDocument[]
  deliverableTasks     DeliverableTask[]
  contentPosts         ContentPost[]
  monthlyReports       MonthlyReport[]
  sharedFiles          SharedFile[]
  meetings             ClientMeeting[]
  socialAccounts       SocialAccount[]
  socialPosts          SocialPost[]
  socialCampaigns      SocialCampaign[]
  emailConversations   Conversation[]

  portalAccess Json? @map("portal_access")

  @@index([email])
  @@index([company])
  @@map("clients")
}

model ClientMeeting {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  title     String
  date      DateTime
  location  String?
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([date])
  @@map("client_meetings")
}

enum ClientType {
  BUSINESS
  INDIVIDUAL
}

model Project {
  id          String              @id @default(uuid())
  name        String
  clientId    String              @map("client_id")
  description String?             @db.Text
  status      ProjectStatus       @default(IN_PROGRESS)
  priority    Priority            @default(MEDIUM)
  progress    Int                 @default(0)
  budget      Int?
  startDate   DateTime?           @map("start_date")
  dueDate     DateTime?           @map("due_date")
  tags        String?             @db.Text
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  teamMembers ProjectTeamMember[]
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("projects")
}

model ProjectTeamMember {
  id         String     @id @default(uuid())
  projectId  String     @map("project_id")
  memberId   String     @map("member_id")
  teamMember TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@index([memberId], map: "project_team_members_member_id_fkey")
  @@map("project_team_members")
}

model TeamMember {
  id         String       @id @default(uuid())
  userId     String?      @unique @map("user_id")
  name       String
  email      String       @unique
  phone      String?
  role       String
  department String?
  status     MemberStatus @default(DRAFT)
  avatar     String?
  photoUrl   String?      @map("photo_url") @db.LongText
  hourlyRate Int?         @map("hourly_rate")
  startDate  DateTime?    @map("start_date")
  bio        String?      @db.Text
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  archivedAt DateTime?    @map("archived_at")

  // Personal Info (Step 1)
  dateOfBirth              String? @map("date_of_birth")
  gender                   String?
  nationalId               String? @map("national_id")
  nationalIdType           String? @map("national_id_type")
  nationality              String?
  homeAddress              String? @map("home_address") @db.Text
  emergencyContactName     String? @map("emergency_contact_name")
  emergencyContactRelation String? @map("emergency_contact_relation")
  emergencyContactPhone    String? @map("emergency_contact_phone")

  // Employment Info (Step 2)
  employmentType String? @map("employment_type")
  managerId      String? @map("manager_id")
  workLocation   String? @map("work_location")

  // Payroll Info (Step 4)
  isHourlyMode       Boolean @default(false) @map("is_hourly_mode")
  basicSalary        Int?    @map("basic_salary")
  housingAllowance   Int?    @map("housing_allowance")
  transportAllowance Int?    @map("transport_allowance")
  otherAllowances    String? @map("other_allowances") @db.Text
  bankName           String? @map("bank_name")
  accountNumber      String? @map("account_number")
  taxId              String? @map("tax_id")
  paymentMethod      String? @map("payment_method")
  currency           String? @default("USD")

  projects      ProjectTeamMember[]
  user          User?               @relation(fields: [userId], references: [id])
  assignedTasks DeliverableTask[]
  manager       TeamMember?         @relation("ManagerReports", fields: [managerId], references: [id])
  reports       TeamMember[]        @relation("ManagerReports")
  files         EmployeeFile[]
  activities    EmployeeActivity[]
  hrDocuments   HrDocument[]
  expenses      Expense[]           @relation("EmployeeExpenses")

  @@index([managerId])
  @@map("team_members")
}

// ─── Employee Files ───────────────────────────────────────────────

model EmployeeFile {
  id         String               @id @default(uuid())
  employeeId String               @map("employee_id")
  category   EmployeeFileCategory
  label      String?
  fileUrl    String               @map("file_url") @db.LongText
  uploadedAt DateTime             @default(now()) @map("uploaded_at")
  uploadedBy String?              @map("uploaded_by")
  employee   TeamMember           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_files")
}

enum EmployeeFileCategory {
  ID_DOC
  CONTRACT
  CV
  CERTIFICATE
  OTHER
}

// ─── Employee Activity Log ────────────────────────────────────────

model EmployeeActivity {
  id          String             @id @default(uuid())
  employeeId  String             @map("employee_id")
  actionType  EmployeeActionType
  performedBy String?            @map("performed_by")
  notes       String?            @db.Text
  timestamp   DateTime           @default(now())
  employee    TeamMember         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_activity")
}

enum EmployeeActionType {
  CREATED
  EDITED
  STATUS_CHANGED
  FILE_UPLOADED
  FILE_DELETED
  REACTIVATED
  ARCHIVED
}

model Invoice {
  id                        String              @id @default(uuid())
  invoiceNumber             String              @unique @map("invoice_number")
  clientId                  String              @map("client_id")
  amount                    Int
  status                    InvoiceStatus       @default(PENDING)
  date                      DateTime
  dueDate                   DateTime            @map("due_date")
  notes                     String?             @db.Text
  taxRate                   Float?              @map("tax_rate")
  discount                  Float?
  discountType              DiscountType?       @map("discount_type")
  deposit                   Int?
  paymentMethod             String?             @map("payment_method")
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")
  items                     InvoiceItem[]
  showSignature             Boolean             @default(true) @map("show_signature")
  showStamp                 Boolean             @default(true) @map("show_stamp")
  deliveryNoteEnabled       Boolean             @default(false) @map("delivery_note_enabled")
  deliveryNoteTitle         String?             @map("delivery_note_title")
  deliveryNoteContent       String?             @map("delivery_note_content") @db.Text
  subscriptionId            String?             @map("subscription_id")
  autoGenerated             Boolean             @default(false) @map("auto_generated")
  paymentConfirmationSentAt DateTime?           @map("payment_confirmation_sent_at")
  reminderSentAt            DateTime?           @map("reminder_sent_at")
  overdueSentAt             DateTime?           @map("overdue_sent_at")
  dueSoonNotifiedAt         DateTime?           @map("due_soon_notified_at")
  client                    Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  verificationTokens        VerificationToken[]

  @@index([clientId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  description String  @db.Text
  quantity    Int
  unitPrice   Int     @map("unit_price")
  position    Int     @default(0)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Proforma {
  id                  String              @id @default(uuid())
  proformaNumber      String              @unique @map("proforma_number")
  clientId            String              @map("client_id")
  amount              Int
  status              ProformaStatus      @default(DRAFT)
  date                DateTime
  dueDate             DateTime            @map("due_date")
  notes               String?             @db.Text
  taxRate             Float?              @map("tax_rate")
  discount            Float?
  discountType        DiscountType?       @map("discount_type")
  deposit             Int?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  items               ProformaItem[]
  showSignature       Boolean             @default(true) @map("show_signature")
  showStamp           Boolean             @default(true) @map("show_stamp")
  deliveryNoteEnabled Boolean             @default(false) @map("delivery_note_enabled")
  deliveryNoteTitle   String?             @map("delivery_note_title")
  deliveryNoteContent String?             @map("delivery_note_content") @db.Text
  client              Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  verificationTokens  VerificationToken[]

  @@index([clientId])
  @@map("proformas")
}

model ProformaItem {
  id          String   @id @default(uuid())
  proformaId  String   @map("proforma_id")
  description String   @db.Text
  quantity    Int
  unitPrice   Int      @map("unit_price")
  position    Int      @default(0)
  proforma    Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)

  @@index([proformaId])
  @@map("proforma_items")
}

model Subscription {
  id                 String              @id @default(uuid())
  clientId           String              @map("client_id")
  packageId          String?             @map("package_id")
  plan               String
  amount             Int
  billingCycle       BillingCycle        @default(MONTHLY) @map("billing_cycle")
  startDate          DateTime            @default(now()) @map("start_date")
  endDate            DateTime?           @map("end_date")
  status             SubscriptionStatus  @default(ACTIVE)
  features           String?             @db.Text
  notes              String?             @db.Text
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  package            Package?            @relation(fields: [packageId], references: [id])
  cycles             SubscriptionCycle[]
  deliverableTasks   DeliverableTask[]
  verificationTokens VerificationToken[]

  @@index([clientId])
  @@index([packageId])
  @@map("subscriptions")
}

model Package {
  id              String               @id @default(uuid())
  name            String
  description     String               @db.Text
  price           Int
  features        String?              @db.Text
  type            PackageType          @default(SUBSCRIPTION)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  packageServices PackageService[]
  subscriptions   Subscription[]
  deliverables    PackageDeliverable[]

  @@map("packages")
}

model Service {
  id              String           @id @default(uuid())
  name            String
  category        String
  basePrice       Int              @map("base_price")
  description     String           @db.Text
  status          ServiceStatus    @default(AVAILABLE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  packageServices PackageService[]

  @@map("services")
}

model PackageService {
  id        String  @id @default(uuid())
  packageId String  @map("package_id")
  serviceId String  @map("service_id")
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceId])
  @@index([serviceId], map: "package_services_service_id_fkey")
  @@map("package_services")
}

model VerificationToken {
  id              String         @id @default(uuid())
  token           String         @unique @db.VarChar(128)
  documentType    String         @map("document_type")
  invoiceId       String?        @map("invoice_id")
  proformaId      String?        @map("proforma_id")
  subscriptionId  String?        @map("subscription_id")
  monthlyReportId String?        @map("monthly_report_id")
  hrDocumentId    String?        @map("hr_document_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  expiresAt       DateTime       @default(dbgenerated("(DATE_ADD(NOW(), INTERVAL 365 DAY))")) @map("expires_at")
  revokedAt       DateTime?      @map("revoked_at")
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  proforma        Proforma?      @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  subscription    Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  monthlyReport   MonthlyReport? @relation(fields: [monthlyReportId], references: [id], onDelete: Cascade)
  hrDocument      HrDocument?    @relation(fields: [hrDocumentId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([proformaId])
  @@index([subscriptionId])
  @@index([monthlyReportId])
  @@index([hrDocumentId])
  @@map("verification_tokens")
}

model AgencySettings {
  id                            String  @id @default(uuid())
  agencyName                    String  @map("agency_name")
  adminEmail                    String  @map("admin_email")
  phone                         String?
  website                       String?
  address                       String? @db.LongText
  currency                      String  @default("USD")
  timezone                      String  @default("UTC")
  logo                          String? @db.LongText
  whiteLogo                     String? @map("white_logo") @db.LongText
  favicon                       String? @db.LongText
  primaryColor                  String? @map("primary_color")
  taxRate                       Float   @default(0) @map("tax_rate")
  defaultInvoiceNotes           String? @map("default_invoice_notes") @db.LongText
  paymentMethods                String? @map("payment_methods") @db.LongText
  socialLinks                   String? @map("social_links") @db.LongText
  notifications                 String? @db.LongText
  signature                     String? @map("signature") @db.LongText
  stamp                         String? @map("stamp") @db.LongText
  enableRecaptcha               Boolean @default(false) @map("enable_recaptcha")
  recaptchaSiteKey              String? @map("recaptcha_site_key")
  recaptchaSecretKey            String? @map("recaptcha_secret_key") @db.Text
  googleAnalyticsEnabled        Boolean @default(false) @map("google_analytics_enabled")
  googleAnalyticsMeasurementId  String? @map("google_analytics_measurement_id")
  developmentMode               Boolean @default(false) @map("development_mode")
  comingSoonMessage             String? @map("coming_soon_message") @db.LongText
  comingSoonCountdown           String? @map("coming_soon_countdown")
  comingSoonBullets             String? @map("coming_soon_bullets") @db.LongText
  openAiApiKey                  String? @map("open_ai_api_key") @db.Text
  claudeApiKey                  String? @map("claude_api_key") @db.Text
  geminiApiKey                  String? @map("gemini_api_key") @db.Text
  mainAiProvider                String  @default("openai") @map("main_ai_provider")
  resendApiKey                  String? @map("resend_api_key") @db.Text
  resendWebhookSecret           String? @map("resend_webhook_secret") @db.Text
  resendInboundDomain           String? @map("resend_inbound_domain")
  emailFrom                     String? @map("email_from")
  mailerName                    String? @map("mailer_name")
  smtpHost                      String? @map("smtp_host")
  smtpPort                      Int?    @map("smtp_port")
  smtpUsername                  String? @map("smtp_username")
  smtpEncryption                String? @map("smtp_encryption")
  smtpDriver                    String? @map("smtp_driver")
  mailEnabled                   Boolean @default(false) @map("mail_enabled")
  hrFallbackApproverId          String? @map("hr_fallback_approver_id")
  googleDriveFolderId           String? @map("google_drive_folder_id")
  googleDriveServiceAccountJson String? @map("google_drive_service_account_json") @db.LongText
  googleDriveClientId           String? @map("google_drive_client_id")
  googleDriveClientSecret       String? @map("google_drive_client_secret") @db.LongText
  googleDriveRefreshToken       String? @map("google_drive_refresh_token") @db.LongText
  googleDriveEnabled            Boolean @default(false) @map("google_drive_enabled")
  oneSignalAppId                String? @map("one_signal_app_id")
  oneSignalApiKey               String? @map("one_signal_api_key") @db.Text
  oneSignalEnabled              Boolean @default(false) @map("one_signal_enabled")

  metaEnabled      Boolean @default(false) @map("meta_enabled")
  tiktokEnabled    Boolean @default(false) @map("tiktok_enabled")
  linkedinEnabled  Boolean @default(false) @map("linkedin_enabled")
  googleEnabled    Boolean @default(false) @map("google_enabled")
  xEnabled         Boolean @default(false) @map("x_enabled")
  pinterestEnabled Boolean @default(false) @map("pinterest_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("agency_settings")
}

model Lead {
  id        String   @id @default(uuid())
  email     String   @unique
  status    String   @default("PENDING")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("leads")
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
  CLIENT
}

enum ClientStatus {
  ACTIVE
  PAUSED
  CHURNED
}

enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MemberStatus {
  DRAFT
  PENDING_DOCUMENTS
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum InvoiceStatus {
  PAID
  PARTIALLY_PAID
  PENDING
  OVERDUE
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ProformaStatus {
  DRAFT
  SENT
  ACCEPTED
  PARTIALLY_PAID
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  TRIAL
}

enum PackageType {
  SERVICE
  SUBSCRIPTION
  ONE_TIME
}

enum ServiceStatus {
  AVAILABLE
  UNAVAILABLE
}

// ─── Social Media Module Enums ────────────────────────────────────

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
  X
  SNAPCHAT
  YOUTUBE
  PINTEREST
  OTHER
}

enum DeliverableType {
  POST
  STORY
  REEL
  SHORT
  VIDEO
  REPORT
  OTHER
}

enum TaskStatus {
  PENDING
  PLANNED
  IN_PROGRESS
  WAITING_APPROVAL
  COMPLETED
  CANCELLED
}

enum DocumentType {
  CONTRACT
  REPORT
  ONBOARDING
  BRAND_GUIDE
  CONTENT_CALENDAR
  OTHER
}

enum MonthlyReportStatus {
  DRAFT
  FINALIZED
}

// ─── Social Media Module Models ───────────────────────────────────

/// Client's connected social media accounts
model ClientSocialProfile {
  id         String         @id @default(uuid())
  clientId   String         @map("client_id")
  platform   SocialPlatform
  handle     String?
  profileUrl String?        @map("profile_url")
  notes      String?        @db.Text
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, platform])
  @@map("client_social_profiles")
}

/// Uploaded documents, contracts, and reports for a client
model ClientDocument {
  id            String       @id @default(uuid())
  clientId      String       @map("client_id")
  title         String
  type          DocumentType @default(OTHER)
  fileUrl       String       @map("file_url")
  internalNotes String?      @map("internal_notes") @db.Text
  clientNotes   String?      @map("client_notes") @db.Text
  expiryDate    DateTime?    @map("expiry_date")
  isSigned      Boolean      @default(false) @map("is_signed")
  clientVisible Boolean      @default(true) @map("client_visible")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_documents")
}

/// Template deliverable definition on a package (e.g. "4x Instagram Reels per month")
model PackageDeliverable {
  id          String          @id @default(uuid())
  packageId   String          @map("package_id")
  name        String
  type        DeliverableType
  quantity    Int
  description String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  package   Package               @relation(fields: [packageId], references: [id], onDelete: Cascade)
  platforms DeliverablePlatform[]

  @@index([packageId])
  @@map("package_deliverables")
}

/// Join table: which platforms a PackageDeliverable targets (avoids JSON storage)
model DeliverablePlatform {
  id            String         @id @default(uuid())
  deliverableId String         @map("deliverable_id")
  platform      SocialPlatform

  deliverable PackageDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@unique([deliverableId, platform])
  @@map("deliverable_platforms")
}

/// A real billing cycle for a subscription (e.g. Mar 1 – Mar 31, 2026)
model SubscriptionCycle {
  id             String   @id @default(uuid())
  subscriptionId String   @map("subscription_id")
  cycleStart     DateTime @map("cycle_start")
  cycleEnd       DateTime @map("cycle_end")
  label          String // e.g. "March 2026"
  tasksGenerated Boolean  @default(false) @map("tasks_generated")
  createdAt      DateTime @default(now()) @map("created_at")

  subscription     Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  deliverableTasks DeliverableTask[]

  @@unique([subscriptionId, cycleStart])
  @@index([subscriptionId])
  @@map("subscription_cycles")
}

/// Actual content task for a specific cycle (generated from PackageDeliverable)
model DeliverableTask {
  id             String          @id @default(uuid())
  clientId       String          @map("client_id")
  subscriptionId String          @map("subscription_id")
  cycleId        String          @map("cycle_id")
  contentPostId  String?         @map("content_post_id")
  title          String
  type           DeliverableType
  dueDate        DateTime?       @map("due_date")
  status         TaskStatus      @default(PENDING)
  teamMemberId   String?         @map("team_member_id")

  // Separated notes: internal vs client-visible
  internalNotes String? @map("internal_notes") @db.Text
  clientNotes   String? @map("client_notes") @db.Text

  // Post tracking
  mediaUrl String?   @map("media_url")
  postUrl  String?   @map("post_url")
  postedAt DateTime? @map("posted_at")
  proofUrl String?   @map("proof_url")

  clientVisible Boolean  @default(true) @map("client_visible")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  client       Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscription Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  cycle        SubscriptionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  contentPost  ContentPost?      @relation(fields: [contentPostId], references: [id], onDelete: SetNull)
  assignee     TeamMember?       @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  platforms    TaskPlatform[]

  @@index([clientId])
  @@index([subscriptionId])
  @@index([cycleId])
  @@index([contentPostId])
  @@index([teamMemberId])
  @@map("deliverable_tasks")
}

/// Join table: which platforms a task targets (avoids JSON storage)
model TaskPlatform {
  id       String         @id @default(uuid())
  taskId   String         @map("task_id")
  platform SocialPlatform

  task DeliverableTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, platform])
  @@map("task_platforms")
}

// ─── Monthly Content Planner ──────────────────────────────────────

enum PostStatus {
  DRAFT
  SCHEDULED
  FILMED
  PUBLISHED
  DELAYED
}

/// A single planned content post for a client's monthly social media calendar
model ContentPost {
  id            String         @id @default(uuid())
  clientId      String         @map("client_id")
  month         Int // 1–12
  year          Int
  title         String
  platform      SocialPlatform
  status        PostStatus     @default(DRAFT)
  contentType   String?        @map("content_type")
  shootingDate  DateTime?      @map("shooting_date")
  publishDate   DateTime?      @map("publish_date")
  notes         String?        @db.Text
  attachmentUrl String?        @map("attachment_url")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  linkedTasks DeliverableTask[]

  @@index([clientId])
  @@index([clientId, month, year])
  @@map("content_posts")
}

model MonthlyReport {
  id            String              @id @default(uuid())
  clientId      String              @map("client_id")
  month         Int
  year          Int
  title         String
  status        MonthlyReportStatus @default(DRAFT)
  sourceText    String              @map("source_text") @db.LongText
  dataQuality   String?             @map("data_quality") @db.LongText
  themeSnapshot String?             @map("theme_snapshot") @db.LongText
  createdById   String?             @map("created_by_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  client             Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy          User?                  @relation("MonthlyReportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sections           MonthlyReportSection[]
  assets             MonthlyReportAsset[]
  versions           MonthlyReportVersion[]
  verificationTokens VerificationToken[]

  @@unique([clientId, month, year])
  @@index([createdById])
  @@map("monthly_reports")
}

model MonthlyReportSection {
  id        String   @id @default(uuid())
  reportId  String   @map("report_id")
  key       String
  order     Int
  content   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  report MonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, key])
  @@index([reportId, order])
  @@map("monthly_report_sections")
}

model MonthlyReportAsset {
  id         String   @id @default(uuid())
  reportId   String   @map("report_id")
  sectionKey String   @map("section_key")
  slotKey    String   @map("slot_key")
  url        String   @db.LongText
  caption    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  report MonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, sectionKey, slotKey])
  @@index([reportId])
  @@map("monthly_report_assets")
}

model MonthlyReportVersion {
  id           String   @id @default(uuid())
  reportId     String   @map("report_id")
  snapshotJson Json     @map("snapshot_json")
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  report    MonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("MonthlyReportVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
  @@index([createdById])
  @@map("monthly_report_versions")
}

// ─── Accounts & Expenses Module ───────────────────────────────────

enum AccountType {
  BANK
  MOBILE_WALLET
  CASH
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  SOFTWARE
  OFFICE
  MARKETING
  RENT
  UTILITIES
  PAYROLL
  EQUIPMENT
  TRAVEL
  COMMUNICATION
  ENTERTAINMENT
  TAXES
  OTHER
}

/// Financial account (bank, mobile wallet, or cash)
model Account {
  id         String      @id @default(uuid())
  name       String
  type       AccountType
  currency   String      @default("USD")
  color      String?
  icon       String?
  image      String?     @db.LongText
  notes      String?     @db.Text
  isArchived Boolean     @default(false) @map("is_archived")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  transfersFrom     AccountTransfer[]  @relation("TransferFrom")
  transfersTo       AccountTransfer[]  @relation("TransferTo")
  deposits          Deposit[]

  @@map("accounts")
}

/// A business expense entry
model Expense {
  id          String   @id @default(uuid())
  accountId   String   @map("account_id")
  employeeId  String?  @map("employee_id")
  amount      Int // stored in smallest currency unit (cents)
  category    String   @default("OTHER")
  description String   @db.Text
  date        DateTime
  receiptUrl  String?  @map("receipt_url") @db.LongText
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account  Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee TeamMember? @relation("EmployeeExpenses", fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([date])
  @@index([category])
  @@index([employeeId])
  @@map("expenses")
}

/// A standing monthly business expense (template, not a real payment)
model RecurringExpense {
  id          String    @id @default(uuid())
  name        String // e.g. "Office Rent"
  category    String    @default("OTHER")
  amount      Int // cents
  accountId   String?   @map("account_id") // preferred payment account
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  dayOfMonth  Int?      @map("day_of_month") // e.g. 1 = 1st of month
  startDate   DateTime  @default(now()) @map("start_date")
  endDate     DateTime? @map("end_date")
  frequency   String    @default("MONTHLY") // "DAILY" | "WEEKLY" | "MONTHLY" | "YEARLY" | "ON_DEMAND"
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@map("recurring_expenses")
}

/// Money transfer between two accounts
model AccountTransfer {
  id            String   @id @default(uuid())
  fromAccountId String   @map("from_account_id")
  toAccountId   String   @map("to_account_id")
  amount        Int // in cents
  note          String?  @db.Text
  date          DateTime
  createdAt     DateTime @default(now()) @map("created_at")

  fromAccount Account @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount   Account @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Cascade)

  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("account_transfers")
}

/// External deposit into an account
model Deposit {
  id          String   @id @default(uuid())
  accountId   String   @map("account_id")
  amount      Int // in cents
  category    String   @default("OTHER") // e.g. OWNER_INVESTMENT, REVENUE, REFUND, OTHER
  description String?  @db.Text
  date        DateTime
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([date])
  @@map("deposits")
}

// ─── HR Document Generator Module ─────────────────────────────────

model HrDocument {
  id            String           @id @default(uuid())
  employeeId    String           @map("employee_id")
  docType       HrDocumentType   @map("doc_type")
  docNumber     String           @map("doc_number")
  status        HrDocumentStatus @default(DRAFT)
  generatedById String?          @map("generated_by_id")
  generatedBy   User?            @relation("HrDocumentGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  generatedAt   DateTime         @default(now()) @map("generated_at")
  approvedById  String?          @map("approved_by_id")
  approvedBy    User?            @relation("HrDocumentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?        @map("approved_at")
  version       Int              @default(1)
  pdfUrl        String?          @map("pdf_url") @db.LongText
  content       Json? // Store the form fields (JSON stringified/parsed)

  employee           TeamMember           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvals          HrDocumentApproval[]
  verificationTokens VerificationToken[]

  @@unique([docNumber, version])
  @@index([employeeId])
  @@index([generatedById])
  @@index([approvedById])
  @@map("hr_documents")
}

model HrDocumentApproval {
  id           String   @id @default(uuid())
  hrDocumentId String   @map("hr_document_id")
  approverId   String   @map("approver_id")
  decision     String // 'APPROVED' or 'REJECTED'
  comment      String?  @db.Text
  decidedAt    DateTime @default(now()) @map("decided_at")

  hrDocument HrDocument @relation(fields: [hrDocumentId], references: [id], onDelete: Cascade)
  approver   User       @relation("HrDocumentApprovals", fields: [approverId], references: [id], onDelete: Cascade)

  @@index([hrDocumentId])
  @@index([approverId])
  @@map("hr_document_approvals")
}

enum HrDocumentType {
  WORK_CERTIFICATE
  SALARY_CERTIFICATE
  PAYSLIP
  WARNING_CERTIFICATE
  INTERNSHIP_ACCEPTED_CERTIFICATE
  INTERNSHIP_LETTER
}

enum HrDocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  FINAL
}

model SharedFile {
  id         String @id @default(uuid())
  shareId    String @unique @default(uuid()) @map("share_id")
  fileName   String @map("file_name")
  storedName String @map("stored_name")
  filePath   String @map("file_path")
  fileSize   Int    @map("file_size")
  mimeType   String @map("mime_type")

  clientId String? @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  uploadedById String  @map("uploaded_by_id")
  uploadedBy   User    @relation("SharedFileUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  message      String? @db.Text

  emailSentTo String?   @map("email_sent_to")
  emailSentAt DateTime? @map("email_sent_at")

  expiresAt     DateTime  @map("expires_at")
  downloadCount Int       @default(0) @map("download_count")
  viewCount     Int       @default(0) @map("view_count")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  deletedAt     DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")

  events SharedFileEvent[]

  @@index([shareId])
  @@index([expiresAt, isDeleted])
  @@map("shared_files")
}

model SharedFileEvent {
  id        String     @id @default(uuid())
  fileId    String     @map("shared_file_id")
  file      SharedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  eventType String     @map("event_type") // "VIEW" | "DOWNLOAD"
  ipAddress String?    @map("ip_address")
  userAgent String?    @map("user_agent")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([fileId])
  @@map("shared_file_events")
}

