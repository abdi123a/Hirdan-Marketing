DATABASE_URL="mysql://user:password@localhost:3306/dbname"
JWT_SECRET="your_jwt_secret_at_least_32_chars"
JWT_REFRESH_SECRET="your_refresh_secret_at_least_32_chars"
PORT=3001
NODE_ENV="production"
FRONTEND_URL="https://app.yourdomain.com"
LANDING_URL="https://yourdomain.com"
SHORT_LINK_DOMAIN="https://yourdomain.cc"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Email (Resend) ───────────────────────────────────────────────
# These are optional if you configure email via the admin settings panel.
# If set here, they take priority over database-stored values.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="noreply@yourdomain.com"
APP_URL="https://app.yourdomain.com"
